# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/tribal_sahay

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# DigiLocker Integration
DIGILOCKER_CLIENT_ID=your_digilocker_client_id
DIGILOCKER_CLIENT_SECRET=your_digilocker_client_secret
DIGILOCKER_REDIRECT_URI=http://localhost:5000/api/digilocker/callback

# Government API Integrations
NSP_API_URL=https://scholarships.gov.in/api
SFMP_API_URL=https://sfmp.canarabank.com/api
NOS_API_URL=https://nosportal.gov.in/api
UDISE_API_URL=https://udiseplus.gov.in/api
APAAR_API_URL=https://apaar.gov.in/api
AISHE_API_URL=https://aishe.gov.in/api
UIDAI_API_URL=https://uidai.gov.in/api

# JAGO Chatbot Integration
JAGO_CHATBOT_API_URL=https://jago.gov.in/api
JAGO_CHATBOT_API_KEY=your_jago_api_key

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Notification Service
SMS_API_KEY=your_sms_api_key
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
